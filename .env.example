# Modelo de configuração. Copie este arquivo como .env.dev e preencha os valores.
# O .env.dev NÃO vai para o repositório (está no .gitignore).

AMBIENTE_PROCESSO=desenvolvimento

# Banco de dados MySQL local
DB_HOST=localhost
DB_DATABASE=pokemon_trainer_hub
DB_USER=root
DB_PASSWORD=
DB_PORT=3306

# Servidor da aplicação
APP_HOST=localhost
APP_PORT=3333
